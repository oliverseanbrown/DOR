@page "/career/player/{Index:int}"
@inherits CareerComponentBase

<PageTitle>Player — Director Of Rugby</PageTitle>

@if (Game.MyClub is { } club && Index >= 0 && Index < club.Squad.Count)
{
    var p = club.Squad[Index];
    var a = p.Attributes;
    bool inXv = club.Players.Contains(p);

    <a class="btn btn-sm" href="career/squad">&larr; Back to squad</a>

    <h1>@p.FullName</h1>
    <p class="hint">
        @p.NaturalPosition.ShortName() (@p.NaturalPosition) · @p.Nationality.DisplayName() · Age @p.Age · Overall @PlayerRating.Overall(p)
        · <b>@PlayerStyle.Determine(p)</b>
        · @(!p.IsFit ? $"INJURED, {p.InjuredWeeksRemaining}w" : inXv ? "Starting XV" : "Bench")
    </p>

    <div class="cards dash-cards">
        <div class="card">
            <h3>Condition</h3>
            <p class="big-stat">@p.Condition%</p>
        </div>
        <div class="card">
            <h3>Potential</h3>
            <p class="big-stat">@PotentialBand(p)</p>
        </div>
        <div class="card">
            <h3>Injury risk</h3>
            <p class="big-stat">@InjuryRiskBand(p)</p>
        </div>
    </div>

    <div class="stat-groups">
        <StatGroup Title="Physical" Attrs="@Physical(a)" Gains="p.TrainingGains" />
        <StatGroup Title="Technical" Attrs="@Technical(a)" Gains="p.TrainingGains" />
        <StatGroup Title="Mental" Attrs="@Mental(a)" Gains="p.TrainingGains" />
    </div>

    @if (p.TrainingGains.Count > 0)
    {
        <p class="footnote">
            Career training gains: @string.Join(", ", p.TrainingGains.OrderByDescending(g => g.Value).Select(g => $"{Spaced(g.Key)} +{g.Value}"))
        </p>
    }

    @if (p.CareerStats.Count > 0)
    {
        <div class="grp-title">Match statistics</div>
        <div class="card" style="padding:0;">
            <table class="league">
                <thead>
                    <tr>
                        <th class="l">Season</th><th>MP</th><th>Tries</th><th>Assists</th><th>Cons</th><th>Pens</th>
                        <th>Carries</th><th>Metres</th><th>Tackles</th><th>TOs</th><th>Errors</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (season, s) in p.CareerStats.OrderBy(kv => kv.Key))
                    {
                        <tr>
                            <td class="l">Season @season</td>
                            <td>@s.MatchesPlayed</td>
                            <td>@s.Tries</td>
                            <td>@s.Assists</td>
                            <td>@s.Conversions</td>
                            <td>@s.PenaltyGoals</td>
                            <td>@s.Carries</td>
                            <td>@($"{s.MetresGained:0}")</td>
                            <td>@s.Tackles</td>
                            <td>@s.TurnoversWon</td>
                            <td>@s.Errors</td>
                        </tr>
                    }
                    @if (p.CareerStats.Count > 1)
                    {
                        var totalMp = p.CareerStats.Values.Sum(s => s.MatchesPlayed);
                        var totalTries = p.CareerStats.Values.Sum(s => s.Tries);
                        var totalAssists = p.CareerStats.Values.Sum(s => s.Assists);
                        var totalCons = p.CareerStats.Values.Sum(s => s.Conversions);
                        var totalPens = p.CareerStats.Values.Sum(s => s.PenaltyGoals);
                        var totalCarries = p.CareerStats.Values.Sum(s => s.Carries);
                        var totalMetres = p.CareerStats.Values.Sum(s => s.MetresGained);
                        var totalTackles = p.CareerStats.Values.Sum(s => s.Tackles);
                        var totalTos = p.CareerStats.Values.Sum(s => s.TurnoversWon);
                        var totalErrors = p.CareerStats.Values.Sum(s => s.Errors);
                        <tr style="font-weight:700;">
                            <td class="l">Career total</td>
                            <td>@totalMp</td>
                            <td>@totalTries</td>
                            <td>@totalAssists</td>
                            <td>@totalCons</td>
                            <td>@totalPens</td>
                            <td>@totalCarries</td>
                            <td>@($"{totalMetres:0}")</td>
                            <td>@totalTackles</td>
                            <td>@totalTos</td>
                            <td>@totalErrors</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <p class="hint">Player not found.</p>
    <a class="btn" href="career/squad">Back to squad</a>
}

@code {
    [Parameter] public int Index { get; set; }

    private static (string Name, int Value)[] Physical(PlayerAttributes a) => new[]
    {
        ("Strength", a.Strength), ("Pace", a.Pace), ("Acceleration", a.Acceleration),
        ("Stamina", a.Stamina), ("Agility", a.Agility),
    };

    private static (string Name, int Value)[] Technical(PlayerAttributes a) => new[]
    {
        ("Handling", a.Handling), ("Passing", a.Passing), ("Tackling", a.Tackling),
        ("Kicking", a.Kicking), ("GoalKicking", a.GoalKicking), ("Lineout", a.Lineout),
        ("Scrummaging", a.Scrummaging), ("Breakdown", a.Breakdown),
    };

    private static (string Name, int Value)[] Mental(PlayerAttributes a) => new[]
    {
        ("DecisionMaking", a.DecisionMaking), ("Composure", a.Composure), ("Discipline", a.Discipline),
        ("WorkRate", a.WorkRate), ("Leadership", a.Leadership), ("Positioning", a.Positioning),
        ("Vision", a.Vision), ("Aggression", a.Aggression),
    };

    private static string PotentialBand(Player p)
    {
        int gap = p.Attributes.Potential - PlayerRating.Overall(p);
        return gap switch
        {
            >= 15 => "High",
            >= 5 => "Some room",
            _ => "Fully developed",
        };
    }

    private static string InjuryRiskBand(Player p) => p.Attributes.InjuryProneness switch
    {
        >= 66 => "High",
        >= 33 => "Medium",
        _ => "Low",
    };

    private static string Spaced(string name)
        => System.Text.RegularExpressions.Regex.Replace(name, "(?<!^)([A-Z])", " $1");
}
